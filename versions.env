# =============================================================================
# DDT - Central version file (single source of truth)
# =============================================================================
# WHAT THIS FILE IS
#   One place that defines the tool versions used by DDT. Do not hard-code
#   these versions anywhere else. Change them HERE, then run the sync script.
#
# FORMAT
#   KEY=VALUE, one per line. No spaces around "=". No quotes needed.
#   Lines that start with "#" are comments.
#
# HOW TO READ IT
#
#   1) Bash / install script (setup_ddt.sh)
#        set -a; source ./versions.env; set +a
#        echo "$YARN_VERSION"
#        corepack prepare "yarn@${YARN_VERSION}" --activate
#
#   2) GitHub Actions (any workflow, after checkout)
#        - name: Load versions
#          run: cat versions.env | grep -v '^#' | grep -v '^$' >> "$GITHUB_ENV"
#        # then use ${{ env.NODE_MIN_VERSION }} in later steps
#
#   3) Node.js script
#        see scripts/sync-versions.mjs (function parseEnv)
#
#   4) Cargo / Rust and package.json
#        These tools cannot read this file directly. Run the sync script and
#        commit the result:
#          corepack yarn versions:sync     # write the values into the files
#          corepack yarn versions:check    # only check, fail if files differ
#
# WHAT THE SYNC SCRIPT WRITES
#   APP_VERSION       -> package.json "version", src-tauri/Cargo.toml [package] version,
#                        src-tauri/tauri.conf.json "version"
#   YARN_VERSION      -> package.json "packageManager" (yarn@<version>)
#   NODE_MIN_VERSION  -> package.json "engines.node" (>=<version>)
#   RUST_MSRV         -> src-tauri/Cargo.toml "rust-version"
#   RUST_TOOLCHAIN    -> rust-toolchain.toml "channel"
#
# NOT WRITTEN BY THE SYNC SCRIPT (checked only)
#   Tauri npm packages vs the "tauri" crate. Changing them also needs
#   yarn.lock / Cargo.lock updates, so they are reported by versions:check.
#
# HOW TO ADD A NEW VALUE LATER (for example a Tauri version)
#   1) Add KEY=VALUE to this file, with a comment that says what it controls.
#   2) In scripts/sync-versions.mjs: add the key to REQUIRED, add a check for its
#      format, write a small build function for the target file, and add that
#      function to the "targets" list. The script already has a template.
#   3) Run: corepack yarn versions:sync, then corepack yarn versions:check.
#   Note: changing dependency ranges also changes yarn.lock / Cargo.lock.
#   Run "corepack yarn install" and "cargo update -p <crate>" and review the diff.
#
# IMPORTANT
#   Node.js cannot be pinned exactly by "apt install nodejs".
#   The install script should CHECK the installed version against
#   NODE_MIN_VERSION and warn. It should not fail on a newer version.
# =============================================================================

# Application version (must match in package.json, Cargo.toml and tauri.conf.json)
# 0.1.2 = the value in tauri.conf.json, which Tauri uses for the built app.
# Confirmed by Cameron Rule (D&D lead) on Teams.
APP_VERSION=0.1.2

# Yarn Berry version, used through Corepack (never use "npm install")
YARN_VERSION=3.8.7

# Lowest Node.js version DDT accepts. 20.0.0 matches the current CI.
# NOTE: Node 20 reached end-of-life on 2026-04-30. Team to decide on 22 or 24.
NODE_MIN_VERSION=20.0.0

# Lowest Rust version for the Cargo package (Cargo.toml "rust-version")
# Measured on src-tauri/Cargo.lock at upstream/main 1dabe94: the highest "rust-version" in the
# dependency tree is 1.88.0 (crate "time"). A future Cargo.lock update can raise this number.
RUST_MSRV=1.88.0

# Rust toolchain used by rustup (rust-toolchain.toml)
# Must be a fixed version (not "stable", which changes over time).
# 1.99.1 = the version on the Kali VM where "cargo check" passed.
RUST_TOOLCHAIN=1.99.1
